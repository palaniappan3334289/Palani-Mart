# PalaniMart Environment Variables Template
JDBC_URL=jdbc:h2:file:./data/palanimart;DB_CLOSE_DELAY=-1;MODE=PostgreSQL;AUTO_SERVER=TRUE
JDBC_USER=sa
JDBC_PASSWORD=
PORT=8080

# Google Gemini AI Shopping Assistant Configuration
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
